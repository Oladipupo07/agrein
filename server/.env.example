# Agrein Server Environment Configuration
#
# Copy this file to `server/.env` and fill in real values. Anything left blank
# will cause the server to refuse to boot in LIVE mode (see the boot guard
# in server/index.js).

# ─── Runtime ────────────────────────────────────────────────────────────────
# Port the Express server binds to. Render free tier assigns 10000.
PORT=5000
NODE_ENV=development

# ─── Auth ───────────────────────────────────────────────────────────────────
# Long random string. Used to sign JWTs. Rotate only on full user re-issue.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Admin seed password (allows authController to seed default admin accounts:
# admin@agrein.com and reapgrime374@gmail.com on startup)
ADMIN_SEED_PASSWORD=AdminPass123!

# ─── Supabase ───────────────────────────────────────────────────────────────
# Source of truth for profiles, orders, products, wallets, etc.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ─── Interswitch API (Payments & Identity KYC: NIN / CAC) ───────────────────
# Set to 'sandbox' to point at sandbox endpoints, or 'production' for LIVE.
# Used for:
#   1. Payment checkout & escrow
#   2. Real-time National Identity Number (NIN) verification via NIMC Gateway
#   3. Real-time Corporate Affairs Commission (CAC) business registry lookup
INTERSWITCH_ENV=sandbox

# Find these in your Quickteller Business dashboard under Settings → API:
INTERSWITCH_MERCHANT_CODE=MX_REPLACE_ME
INTERSWITCH_PAY_ITEM_ID=REPLACE_ME
INTERSWITCH_CLIENT_ID=IKIA_REPLACE_ME
INTERSWITCH_SECRET_KEY=REPLACE_ME

# Optional override endpoints (defaults to official Interswitch Sandbox/Production URLs)
# INTERSWITCH_PASSPORT_URL=https://sandbox.interswitchng.com/passport/oauth/token
# INTERSWITCH_API_BASE=https://sandbox.interswitchng.com

# ─── Public site URL ────────────────────────────────────────────────────────
# Used to build the site_redirect_url that Interswitch POSTs back to.
# Must be HTTPS in LIVE mode (Interswitch requires it).
APP_URL=http://localhost:5000

# ─── Brevo Transactional Email ──────────────────────────────────────────────
# Used by otpService for verification & password-reset emails.
BREVO_API_KEY=xkeysib-YOUR_BREVO_KEY
MAIL_FROM_ADDRESS=akobeoladipupo@gmail.com
MAIL_FROM_NAME="Agrein Market"

# ─── SMTP Email Fallback (Optional) ─────────────────────────────────────────
# Used when BREVO_API_KEY is not configured
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_PASS
